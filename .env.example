# Esempio per sviluppo locale (su Render queste variabili si impostano dalla dashboard / render.yaml)
DB_PROVIDER=postgresql
DB_CONNECTION_URL=postgresql://utente:password@localhost:5432/tickets
DISCORD_TOKEN=
DISCORD_SECRET=
ENCRYPTION_KEY=            # minimo 48 caratteri, NON perderla: serve a decifrare i ticket
HTTP_EXTERNAL=http://127.0.0.1:8169
HTTP_HOST=0.0.0.0
HTTP_PORT=8169
HTTP_TRUST_PROXY=false
PUBLIC_BOT=false
PUBLISH_COMMANDS=true
# Superuser del bot (impostazioni di tutti i server) e proprietari dell'area staff, ID separati da virgola
SUPER=1254356172631179297
STAFF_OWNER_ID=1254356172631179297
